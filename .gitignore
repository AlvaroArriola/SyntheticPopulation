# Datos: no se versionan salvo los manifiestos (docs/02, sección 6)
data/**
!data/**/
!data/raw/MANIFEST.yaml
!data/raw/MANUAL_DOWNLOADS.md
!data/**/.gitkeep
# Caché y registros de LLM
logs/llm/**
!logs/llm/.gitkeep
# la caché de respuestas y el registro de gasto se versionan: hacen reproducibles las
# ejecuciones con LLM y auditable el gasto (solo contienen enunciados públicos y agregados)
!logs/llm/cache/
!logs/llm/cache/*.json
!logs/llm/gasto.jsonl
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/
.venv/
build/
dist/
data/raw/MANIFEST.lock
